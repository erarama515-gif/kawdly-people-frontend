# Kawdly People — frontend environment template.
#
# Copy to `.env.local` (gitignored) and edit. `npm run dev` copies it for you on
# first run — see scripts/check-env.mjs.
#
# Every value below is the project default as read by src/config/env.ts. Keys
# other than VITE_API_BASE_URL are optional: delete them and the code default
# applies. Values here are deliberately NOT secrets — never put a token, key or
# password in this file or in .env.local.


# ── Required ──────────────────────────────────────────────────────────────────
#
# Base path for every API call. `/api/v1` relies on the Vite dev-server proxy in
# vite.config.ts, which forwards /api to http://127.0.0.1:8100 — port 8100, NOT
# Laravel's default 8000, because on this project's dev machine 8000 is owned by
# an unrelated Tourism ERP and pointing there produces failures that look like
# auth bugs.
#
# Start the backend with:  php artisan serve --port=8100
#
# Leaving this empty has very different consequences per build:
#   - `npm run dev`   → the app silently serves FABRICATED mock data (it looks
#                       like it works; the numbers are fake)
#   - production web  → src/config/env.ts throws at startup, by design, rather
#                       than show invented statistics
#   - desktop build   → unaffected; electron/src/desktop-config.ts injects
#                       __KAWDLY_CONFIG__ at runtime, which takes precedence
VITE_API_BASE_URL=/api/v1


# ── Optional ──────────────────────────────────────────────────────────────────

# Force the in-process mock API even when a base URL is set. Only `true` counts.
# Default: mock is used in dev when VITE_API_BASE_URL is empty, otherwise real
# HTTP. In a production build this is the ONLY way to opt into mock data.
# VITE_USE_MOCK_API=false

# Per-request timeout in ms. Default: 10000
# VITE_REQUEST_TIMEOUT_MS=10000

# Retry attempts after a failed request. Default: 2
# VITE_REQUEST_RETRIES=2

# Base backoff between retries in ms. Default: 400
# VITE_REQUEST_BACKOFF_MS=400

# How often live dashboard resources revalidate, in ms. Default: 60000
# VITE_DASHBOARD_POLL_MS=60000
