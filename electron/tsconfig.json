{
  // Electron main + preload. Extends the repo's Node-side base and then overrides
  // every option that is specific to "bundler, type-check only" so that this project
  // actually EMITS CommonJS JavaScript for the Electron runtime.
  //
  // NOT yet listed in ../tsconfig.json "references": `tsc -b` must stay EXIT 0, and
  // this project cannot resolve `electron` until `npm i -D electron` runs (T? install
  // step). Wiring it into the root references is a one-line change at that point.
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    /* `composite` was set in T1 and is deliberately REMOVED in T3. A composite
       project may not disable emit, which made `tsc -p electron/tsconfig.json
       --noEmit` (the npm "typecheck:desktop" gate) a hard TS6304 error. composite
       bought nothing here because this project is intentionally absent from the
       root "references" list, so `tsc -b` never treats it as a dependency.
       `incremental` keeps the build cache; `declaration` went with composite since
       nothing consumes .d.ts files from the main process.
       It must be switched off EXPLICITLY: `composite: true` is inherited from
       ../tsconfig.node.json (which needs it, because the root `tsc -b` references
       that project), and simply omitting the key here leaves it enabled.

       `incremental` is off for the same reason, after being measured: with a
       tsbuildinfo present but dist/ deleted, `tsc -p` exits 0 and emits NOTHING,
       so `electron:dev` would launch a stale or absent main.js. A full compile of
       this project is ~1s — not worth the footgun. */
    "composite": false,
    "incremental": false,

    /* Emit: this is the one TS project in the repo that produces runtime JS. */
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false,

    /* CommonJS, because Electron's sandboxed preload cannot be an ES module and the
       root package.json declares "type": "module". electron/package.json re-declares
       "type": "commonjs" so the emitted dist/*.js is resolved as CJS at runtime. */
    "module": "CommonJS",
    "moduleResolution": "node10",

    /* Overrides forced by the two options above (each would otherwise be an error):
       - allowImportingTsExtensions requires noEmit
       - verbatimModuleSyntax forbids ESM import syntax in a CommonJS module */
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,

    /* Node 20/22 is what Electron 3x embeds; no DOM lib in the main process. */
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
