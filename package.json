{
  "name": "kawdly-people",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "predev": "node scripts/check-env.mjs --create",
    "dev": "vite",
    "prebuild": "node scripts/check-env.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "typecheck:desktop": "tsc -p electron/tsconfig.json --noEmit",
    "test:electron": "tsc -p electron/tsconfig.json && node --test \"electron/test/*.test.mjs\"",
    "preview": "vite preview",
    "build:desktop": "tsc -b && vite build --base=/app/ --outDir ../backend/public/app --emptyOutDir",
    "electron:build": "npm run build:desktop && npx tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && electron electron/dist/main.js",
    "make:icon": "node scripts/make-placeholder-icon.mjs",
    "stage:backend": "node scripts/stage-backend.mjs",
    "verify:staging": "node scripts/stage-backend.mjs --verify",
    "package:dir": "npm run electron:build && npm run stage:backend && electron-builder --dir",
    "package:win": "npm run electron:build && npm run stage:backend && electron-builder --win nsis"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.8",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
